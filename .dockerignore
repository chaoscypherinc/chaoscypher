# Docker build context exclusions
# Keep this file in sync with .gitignore

# Node modules (huge)
**/node_modules/

# Python caches
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.eggs/
**/build/
**/dist/
**/*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage_html/
.tox/
.nox/

# Cache directories
.mypy_cache/
.ruff_cache/

# Docker data volumes (mounted, not copied)
packages/docker/data/
packages/docker/test-output/

# Documentation build
docs/_build/

# Test trees — no Dockerfile copies these at build time (test runner mounts
# them at runtime). Defense in depth against accidental inclusion.
**/tests/
# Frontend test files too: the production image's frontend-builder stage runs
# `tsc` over everything it copies, and a test that imports a fixture from a
# sibling package (defaultPublicSettingsDrift.test.ts -> packages/cortex/tests)
# resolves in the monorepo but not inside the image, which broke the image
# build and held the v0.4.2 tag (#557, 2026-09-08). Tests never belong in the
# image, so keep them out of the build context outright.
**/__tests__/
**/*.test.ts
**/*.test.tsx

# Build-supporting files (lint configs, plans, ADRs, scripts) — never shipped.
internal/

# Docusaurus site — built and served separately, not part of any image.
packages/docs/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local env files
.env
.env.local
*.local

# Test databases
*.db
*.sqlite

# Large binary files
*.pdf
*.zip
*.tar.gz
*.rar
