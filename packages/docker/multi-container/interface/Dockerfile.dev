# Chaos Cypher Interface - Development with Vite hot-reload
FROM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app

# Copy package files
COPY packages/interface/package*.json packages/interface/.npmrc ./

# Install dependencies (ci for reproducible builds)
RUN npm ci

# Copy source code (will be overridden by volume mount in dev)
COPY packages/interface ./

# Expose Vite dev server port
EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

# Start Vite dev server with hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
