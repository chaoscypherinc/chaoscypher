{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:financial",
  "name": "financial",
  "version": "2.0.0",
  "description": "Financial documents, market analysis, investment, and economic reports",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.2,
  "type_aliases": {
    "Stock": "Financial Instrument",
    "Equity": "Financial Instrument",
    "Share": "Financial Instrument",
    "SEC": "Regulator",
    "FINRA": "Regulator",
    "CFTC": "Regulator"
  },
  "entity_exclusions": [
    {
      "description": "Raw numbers alone",
      "examples": [
        "$5M",
        "15%",
        "Q3 2024"
      ]
    },
    {
      "description": "Boilerplate disclaimers",
      "examples": [
        "past performance",
        "not financial advice",
        "forward-looking statements"
      ]
    }
  ],
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "financial_core": {
        "terms": [
          "stock",
          "bond",
          "equity",
          "dividend",
          "investment",
          "portfolio",
          "asset",
          "liability",
          "revenue",
          "profit",
          "loss"
        ],
        "weight": 1.2
      },
      "markets": {
        "terms": [
          "market",
          "exchange",
          "NYSE",
          "NASDAQ",
          "trading",
          "IPO",
          "bull market",
          "bear market",
          "volatility",
          "index"
        ],
        "weight": 1.0
      },
      "metrics": {
        "terms": [
          "P/E ratio",
          "market cap",
          "ROI",
          "EBITDA",
          "EPS",
          "yield",
          "spread",
          "margin",
          "leverage",
          "liquidity"
        ],
        "weight": 1.1
      },
      "instruments": {
        "terms": [
          "derivative",
          "option",
          "futures",
          "swap",
          "hedge fund",
          "mutual fund",
          "ETF",
          "security",
          "treasury",
          "commodity"
        ],
        "weight": 0.9
      },
      "corporate": {
        "terms": [
          "merger",
          "acquisition",
          "IPO",
          "quarterly",
          "annual report",
          "earnings",
          "shareholder",
          "CEO",
          "CFO",
          "board"
        ],
        "weight": 0.9
      },
      "regulation": {
        "terms": [
          "SEC",
          "GAAP",
          "IFRS",
          "compliance",
          "audit",
          "disclosure",
          "fiduciary",
          "regulatory"
        ],
        "weight": 0.8
      }
    },
    "file_extensions": [
      ".pdf"
    ],
    "doc_types": [
      "financial_report",
      "market_analysis",
      "investment_document"
    ],
    "patterns": [
      {
        "regex": "(?i)\\$[\\d,]+\\.?\\d*\\s*(million|billion|trillion|m|b|k)?\\b",
        "weight": 1.4,
        "description": "Dollar amounts"
      },
      {
        "regex": "\\b\\d+(\\.\\d+)?\\s*%\\b",
        "weight": 1.2,
        "description": "Percentage values"
      },
      {
        "regex": "(?i)\\b(q[1-4]|fy|h[12])\\s*['’]?\\d{2,4}\\b",
        "weight": 1.3,
        "description": "Quarter/Fiscal year/Half"
      },
      {
        "regex": "(?i)\\b[A-Z]{1,5}\\b(?=\\s+(stock|shares|equity|common|preferred))",
        "weight": 1.1,
        "description": "Ticker symbols"
      },
      {
        "regex": "(?i)\\b(revenue|earnings|ebitda|profit|loss|margin|growth)\\b",
        "weight": 1.0,
        "description": "Financial metrics"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.1,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract companies, financial instruments, markets, regulators, and investors\n- Include financial metrics as properties, not standalone entities\n- Use full company names with ticker symbols as aliases\n\nDO NOT EXTRACT:\n- Raw numbers alone: '$5M', '15%', 'Q3 2024' (attach to relevant entity as property)\n- Ticker symbols without context: just 'AAPL' (extract the company instead)\n- Boilerplate disclaimers: 'past performance', 'not financial advice'\n- Footnote markers, table headers, or formatting elements",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- TRANSACTIONS: Capture M&A with acquired, investments with invested_in\n- MARKETS: Link instruments to exchanges with trades_on\n- REGULATION: Connect regulators to companies/markets with regulates\n",
  "subtypes": [
    {
      "name": "Financial Instrument",
      "of": "Object",
      "description": "A stock, bond, derivative, or other financial instrument",
      "properties": [
        {
          "name": "instrument_type",
          "display_name": "Instrument Type",
          "property_type": "text"
        },
        {
          "name": "maturity",
          "display_name": "Maturity",
          "property_type": "text"
        }
      ],
      "icon": "Receipt",
      "color": "#d6417d",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "stock",
        "bond",
        "security",
        "derivative",
        "share",
        "equity"
      ]
    },
    {
      "name": "Company",
      "of": "Organization",
      "description": "A business entity or corporation",
      "properties": [
        {
          "name": "ticker",
          "display_name": "Ticker Symbol",
          "property_type": "text"
        },
        {
          "name": "sector",
          "display_name": "Sector",
          "property_type": "text"
        },
        {
          "name": "market_cap",
          "display_name": "Market Capitalization",
          "property_type": "text"
        }
      ],
      "icon": "Business",
      "color": "#d64145",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "company",
        "corporation",
        "firm",
        "business",
        "Inc.",
        "Ltd.",
        "Corp."
      ]
    },
    {
      "name": "Market",
      "of": "Organization",
      "description": "A financial market or exchange",
      "icon": "TrendingUp",
      "color": "#d67541",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "market",
        "exchange",
        "NYSE",
        "NASDAQ",
        "stock exchange",
        "trading"
