  "extraction_limits": {
    "max_relationship_ratio": 7.0,
    "loop_max_entity_count": 35
  },
  "quality_scoring": {
    "default_entity_score": 18,
    "default_relationship_score": 15
  },
  "examples": {
    "alias_examples": [
      {
        "canonical": "Franklin Delano Roosevelt",
        "aliases": [
          "FDR",
          "President Roosevelt",
          "Roosevelt"
        ],
        "note": "Initials and titles become aliases"
      },
      {
        "canonical": "Democratic Party",
        "aliases": [
          "Democrats",
          "Dems",
          "DNC"
        ],
        "note": "Short names and abbreviations become aliases"
      }
    ],
    "relationship_examples": [
      {
        "source": "President Biden",
        "target": "Infrastructure Investment Act",
        "type": "enacts",
        "note": "Use enacts for signing legislation into law"
      },
      {
        "source": "Senator Warren",
        "target": "Banking Reform Bill",
        "type": "cosponsored",
        "note": "Use cosponsored for legislative co-authorship"
      }
    ]
  },
