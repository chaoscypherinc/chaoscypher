  "extraction_limits": {
    "max_relationship_ratio": 8.0,
    "loop_max_entity_count": 40
  },
  "quality_scoring": {
    "default_entity_score": 18,
    "default_relationship_score": 15
  },
  "examples": {
    "alias_examples": [
      {
        "canonical": "Samuel Clemens",
        "aliases": [
          "Mark Twain",
          "Sam Clemens"
        ],
        "note": "Pen names and nicknames become aliases"
      },
      {
        "canonical": "Marie Curie",
        "aliases": [
          "Maria Sklodowska",
          "Madame Curie"
        ],
        "note": "Maiden names and honorific titles become aliases"
      },
      {
        "canonical": "Muhammad Ali",
        "aliases": [
          "Cassius Clay",
          "The Greatest"
        ],
        "note": "Birth names and epithets become aliases"
      }
    ],
    "relationship_examples": [
      {
        "source": "Marie Curie",
        "target": "Pierre Curie",
        "type": "married_to",
        "note": "Use married_to for marriages"
      },
      {
        "source": "Albert Einstein",
        "target": "Nobel Prize in Physics",
        "type": "awarded",
        "note": "Use awarded for honors and prizes"
      },
      {
        "source": "Charles Darwin",
        "target": "On the Origin of Species",
        "type": "published",
        "note": "Use published for authored works"
      }
    ]
  },
