{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:biographical",
  "name": "biographical",
  "version": "2.0.0",
  "description": "Biographies, memoirs, personal histories, and biographical documents",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.0,
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "biographical_core": {
        "terms": [
          "biography",
          "memoir",
          "autobiography",
          "life story",
          "personal history",
          "born",
          "early life"
        ],
        "weight": 1.2
      },
      "life_events": {
        "terms": [
          "birth",
          "divorce",
          "graduation",
          "career",
          "retirement",
          "achievement",
          "award",
          "milestone"
        ],
        "weight": 1.0
      },
      "relationships": {
        "terms": [
          "spouse",
          "sibling",
          "mentor",
          "colleague"
        ],
        "weight": 0.9
      },
      "education_career": {
        "terms": [
          "education",
          "school",
          "university",
          "degree",
          "occupation"
        ],
        "weight": 0.8
      },
      "legacy": {
        "terms": [
          "legacy",
          "contribution",
          "influence",
          "remembered for",
          "known for",
          "famous for",
          "notable",
          "pioneered"
        ],
        "weight": 0.8
      },
      "time_markers": {
        "terms": [
          "years old",
          "at age",
          "in his youth",
          "during her career",
          "later in life",
          "final years"
        ],
        "weight": 0.7
      }
    },
    "file_extensions": [],
    "doc_types": [
      "biography",
      "memoir",
      "obituary",
      "profile"
    ],
    "patterns": [
      {
        "regex": "(?i)\\b(born|died|b\\.|d\\.)\\s+(on\\s+)?[A-Z][a-z]+\\s+\\d{1,2},?\\s+\\d{4}\\b",
        "weight": 1.5,
        "description": "Birth/death dates"
      },
      {
        "regex": "\\([^()]{0,80}?\\b\\d{3,4}\\s*[-–—]\\s*(?:[^()]{0,40}?\\b)?\\d{3,4}\\)",
        "weight": 1.4,
        "description": "Life span in parentheses"
      },
      {
        "regex": "(?i)\\b(at age|aged|at the age of)\\s+\\d+\\b",
        "weight": 1.2,
        "description": "Age references"
      },
      {
        "regex": "(?m)^\\s*(?:Early life|Childhood|Education|Career|Personal life|Legacy|Death)(?: and [a-z]+(?: [a-z]+)?)?\\s*$",
        "weight": 1.0,
        "description": "Biography section headers"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.0,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_exclusions": [
    {
      "description": "Bare date ranges without context",
      "examples": [
        "1920-1985",
        "1800s"
      ]
    },
    {
      "description": "Source citations and footnote markers",
      "examples": [
        "[1]",
        "(ibid.)"
      ]
    },
    {
      "description": "Vague time references",
      "examples": [
        "in his youth",
        "later in life",
        "during this period"
      ]
    }
  ],
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- NAMES: Use canonical name. Put ALL variants in aliases (maiden names, pen names, titles, nicknames)\n- TIMELINE: Capture life events with dates in properties when mentioned\n- Extract people, organizations, locations, and events\n\nDO NOT EXTRACT:\n- Vague time references: 'in his youth', 'later in life', 'during this period'\n- Source citations: [1], (ibid.), page numbers\n- Editorial commentary: 'it is said that', 'historians believe'",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- FAMILY: Use married_to, parent_of, child_of for family relationships\n- CAREER: Link achievements to institutions with worked_at, educated_at\n- Use influenced for mentorship and influence relationships\n",
  "subtypes": [
    {
      "name": "Life Event",
      "of": "Event",
      "description": "An event in a person's life (birth, marriage, career change)",
      "properties": [
        {
          "name": "event_date",
          "display_name": "Date",
          "property_type": "date"
        },
        {
          "name": "event_location",
          "display_name": "Location",
          "property_type": "text"
        }
      ],
      "icon": "Event",
      "color": "#49d641",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "event",
        "occurred",
        "happened",
        "took place",
        "born",
        "died",
        "married"
      ]
    },
    {
      "name": "Achievement",
      "of": "Event",
      "description": "An award, accomplishment, or milestone",
      "properties": [
        {
          "name": "achievement_date",
          "display_name": "Date",
          "property_type": "date"
        },
        {
          "name": "achievement_type",
          "display_name": "Type",
          "property_type": "text"
        }
      ],
      "icon": "EmojiEvents",
      "color": "#41d679",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "achievement",
        "accomplishment",
        "award",
        "won",
        "received",
        "earned",
        "achieved"
      ]
    },
    {
      "name": "Personal Relationship",
      "of": "Concept",
      "description": "A family, professional, or personal relationship",
      "icon": "FamilyRestroom",
      "color": "#41d6b9",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "relationship",
        "married to",
        "father of",
        "mother of",
        "friend of",
        "colleague"
      ]
    },
    {
      "name": "Institution",
      "of": "Organization",
      "description": "A school, employer, or organization",
      "icon": "AccountBalance",
      "color": "#41b4d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "school",
        "university",
        "company",
        "organization",
        "institution",
        "employer"
      ]
    },
    {
      "name": "Era",
      "of": "Event",
      "description": "A historical or life period",
      "icon": "Timeline",
      "color": "#4f41d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "era",
        "period",
        "age",
        "time of",
        "during the",
        "century"
      ]
    },
    {
      "name": "Legacy",
      "of": "Concept",
      "description": "Lasting impact or contribution",
      "icon": "AutoAwesome",
      "color": "#ce41d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "legacy",
        "remembered for",
        "known for",
        "contribution to",
        "impact on"
      ]
    },
    {
      "name": "Career",
      "of": "Event",
      "description": "A professional role, position, or career stage",
      "icon": "Work",
      "color": "#d6419e",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "career",
        "position",
        "role",
        "appointed",
        "served as",
        "worked as"
      ]
    },
    {
      "name": "Education",
      "of": "Event",
      "description": "A degree, training, or educational attainment",
      "icon": "School",
      "color": "#d6415e",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "education",
        "degree",
        "studied",
        "graduated",
        "trained"
      ]
    },
    {
      "name": "Residence",
      "of": "Location",
      "description": "A place of habitation or long-term stay",
      "icon": "Home",
      "color": "#d66441",
      "quality_score": 15,
      "requires_named_referent": true,
      "rescue_keywords": [
        "residence",
        "home",
        "lived in",
        "settled in",
        "moved to"
      ]
    },
    {
      "name": "Legacy Impact",
      "of": "Concept",
      "description": "A lasting influence on a field, institution, or culture",
      "icon": "Insights",
      "color": "#d6a441",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "legacy",
        "impact",
        "lasting influence",
        "changed the course of",
        "pioneered"
      ]
    },
    {
      "name": "Award",
      "of": "Concept",
      "description": "A formal recognition, prize, or honor",
      "icon": "MilitaryTech",
      "color": "#c9d641",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "award",
        "prize",
        "honor",
        "medal",
        "fellowship",
        "recognition"
      ]
    }
  ],
  "core_properties": {
    "Person": [
      {
        "name": "birth_date",
        "display_name": "Birth Date",
        "property_type": "date"
      },
      {
        "name": "death_date",
        "display_name": "Death Date",
        "property_type": "date"
      },
      {
        "name": "birth_place",
        "display_name": "Birth Place",
        "property_type": "text"
      },
      {
        "name": "occupation",
        "display_name": "Occupation",
        "property_type": "text"
      },
      {
        "name": "title",
        "display_name": "Title/Rank",
        "property_type": "text"
      },
      {
        "name": "nationality",
        "display_name": "Nationality",
        "property_type": "text"
      }
    ]
  },
  "core_rescue_keywords": {
    "Person": [
      "person",
      "individual",
      "subject",
      "figure"
    ],
    "Location": [
      "city",
      "town",
      "country",
      "place",
      "location",
      "born in",
      "lived in"
    ],
    "Work": [
      "work",
      "book",
      "invention",
      "creation",
      "contribution",
      "published"
    ]
  },
  "templates": {
    "edge_templates": [
      {
        "@type": "EdgeTemplate",
        "id": "bio_edge_experienced",
        "name": "experienced",
        "description": "Subject (Person or Institution) experienced a life event or another occurrence",
        "icon": "Timeline",
        "color": "#cc32a9",
        "quality_score": 15,
        "source_types": [
          "Person",
          "Organization"
        ],
        "target_types": [
          "Event"
        ],
        "two_endpoints_only": true
      },
      {
        "@type": "EdgeTemplate",
        "id": "bio_edge_achieved",
        "name": "achieved",
        "description": "Person or Institution achieved an accomplishment or award",
        "icon": "EmojiEvents",
        "color": "#cc327f",
        "quality_score": 25,
        "source_types": [
          "Person",
          "Organization"
        ],
        "target_types": [
          "Event",
          "Concept"
        ],
        "two_endpoints_only": true
      },
      {
        "@type": "EdgeTemplate",
        "id": "bio_edge_married_to",
        "name": "married_to",
        "description": "Person married to another person",
        "icon": "FamilyRestroom",
        "color": "#cc3932",
        "symmetric": true,
        "quality_score": 25,
        "source_types": [
          "Person"
        ],
        "target_types": [
