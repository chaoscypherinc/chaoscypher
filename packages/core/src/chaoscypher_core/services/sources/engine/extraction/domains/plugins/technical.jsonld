{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:technical",
  "name": "technical",
  "version": "2.0.0",
  "description": "Technical documentation, code, APIs, and software libraries",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.2,
  "type_aliases": {
    "Func": "Function",
    "API": "Endpoint",
    "Lib": "Package",
    "Library": "Package",
    "Var": "Constant",
    "Variable": "Constant"
  },
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "code": {
        "terms": [
          "def ",
          "class ",
          "function",
          "import ",
          "return",
          "async ",
          "await ",
          "const ",
          "var ",
          "let "
        ],
        "weight": 1.0
      },
      "api": {
        "terms": [
          "endpoint",
          "request",
          "response",
          "rest",
          "api",
          "get",
          "post",
          "patch",
          "delete",
          "http",
          "json"
        ],
        "weight": 0.8
      },
      "tech": {
        "terms": [
          "module",
          "package",
          "library",
          "framework",
          "parameter",
          "exception",
          "method",
          "attribute",
          "instance",
          "constructor"
        ],
        "weight": 0.6
      }
    },
    "file_extensions": [
      ".py",
      ".js",
      ".ts",
      ".rst",
      ".html",
      ".md",
      ".jsx",
      ".tsx"
    ],
    "doc_types": [
      "sphinx_html",
      "markdown",
      "openapi"
    ],
    "patterns": [
      {
        "regex": "```[\\w]*\\n",
        "weight": 1.5,
        "description": "Code blocks in markdown"
      }
    ],
    "confidence": {
      "base_score": 0.3,
      "per_keyword_boost": 0.05,
      "extension_boost": 0.1,
      "doc_type_boost": 0.2,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_exclusions": [
    {
      "description": "Generic variable names",
      "examples": [
        "x",
        "temp",
        "result",
        "data",
        "i",
        "j"
      ]
    }
  ],
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract modules, classes, functions, methods, exceptions, and parameters\n- Use canonical names: 'asyncio', 'collections.abc', 'StopIteration' (preserve original casing)\n- Technical entity names are typically lowercase (e.g., 'asyncio', 'dataclass', 'contextmanager') — this is correct\n- Include type hints and return types in descriptions\n- Extract PEPs and RFCs as Specification entities (e.g., 'PEP 484', 'RFC 7231')\n\nDO NOT EXTRACT:\n- Code syntax: brackets, parentheses, operators\n- Generic variable names: 'x', 'temp', 'result', 'data'\n- Line numbers or file paths as entities\n- Glossary section headings or navigation labels",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- HIERARCHY: Use contains for module->class->method relationships\n- INHERITANCE: Always capture inherits_from for base classes\n- SIGNATURES: Extract parameters with has_parameter, return types with returns\n- ERRORS: Link exceptions with raises relationship\n- SPECIFICATIONS: Link PEPs/RFCs to what they define using 'specifies' relationship\n- Write each stated relationship once; two entities have several relationships when the text states several\n",
  "subtypes": [
    {
      "name": "Module",
      "of": "Object",
      "description": "Python module or code package",
      "properties": [
        {
          "name": "author",
          "display_name": "Author",
          "property_type": "text"
        }
      ],
      "icon": "Inventory2",
      "color": "#d64178",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "a module",
        "module for",
        "module containing",
        "this module",
        "python module",
        "provides functions"
      ]
    },
    {
      "name": "Class",
      "of": "Object",
      "description": "Object-oriented class definition",
      "properties": [
        {
          "name": "base_class",
          "display_name": "Base Class",
          "property_type": "text"
        },
        {
          "name": "abstract",
          "display_name": "Abstract",
          "property_type": "text"
        }
      ],
      "icon": "DataObject",
      "color": "#d64a41",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "a class",
        "class definition",
        "class that",
        "this class",
        "abstract class",
        "base class",
        "subclass of",
        "inherits from"
      ]
    },
    {
      "name": "Function",
      "of": "Object",
      "description": "Standalone function",
      "properties": [
        {
          "name": "return_type",
          "display_name": "Return Type",
          "property_type": "text"
        },
        {
          "name": "async",
          "display_name": "Async",
          "property_type": "text"
        }
      ],
      "icon": "Functions",
      "color": "#d68a41",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "a function",
        "function that",
        "this function",
        "callable",
        "takes parameters"
      ]
    },
    {
      "name": "Method",
      "of": "Concept",
      "description": "Method within a class",
      "icon": "Code",
      "color": "#d6ca41",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "a method",
        "method of",
        "instance method",
        "class method",
        "static method",
        "method that"
      ]
    },
    {
      "name": "Parameter",
      "of": "Object",
      "description": "Function/method parameter",
      "icon": "Tune",
      "color": "#a2d641",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "parameter",
        "argument",
        "accepts",
        "optional argument",
        "required parameter"
      ]
    },
    {
      "name": "Exception",
      "of": "Object",
      "description": "Error/exception type",
      "icon": "BugReport",
      "color": "#62d641",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "exception",
        "error type",
        "raised when",
        "error class",
        "is raised",
        "subclass of exception"
      ]
    },
    {
      "name": "Constant",
      "of": "Object",
      "description": "Constant value or configuration",
      "icon": "Tag",
      "color": "#41d660",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "constant",
        "configuration",
        "default value",
        "flag",
        "enum value"
      ]
    },
    {
      "name": "Package",
      "of": "Object",
      "description": "Software package or library",
      "icon": "Inventory2",
      "color": "#41d6a0",
      "quality_score": 15,
      "requires_named_referent": true
    },
    {
      "name": "Interface",
      "of": "Object",
      "description": "An interface defining a method contract that implementations must satisfy (Java/C# interface, Go interface, ABC)",
      "icon": "Api",
      "color": "#41cdd6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "interface",
        "abstract base",
        "contract",
        "ABC"
      ]
    },
    {
      "name": "Protocol",
      "of": "Concept",
      "description": "A structural protocol or duck-typed contract (Python typing.Protocol, Swift protocol, Rust trait)",
      "icon": "Hub",
      "color": "#41a8d6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "protocol",
        "trait",
        "typeclass",
        "structural type"
      ]
    },
    {
      "name": "Type",
      "of": "Object",
      "description": "A concrete type definition — a struct, enum, generic type, or named type (e.g. ``struct User``, ``Result<T, E>``)",
      "properties": [
        {
          "name": "concept",
          "display_name": "Concept",
          "property_type": "text"
        }
      ],
      "icon": "Label",
      "color": "#418dd6",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "type",
        "type definition",
        "generic type",
        "struct",
        "enum"
      ]
    },
    {
      "name": "TypeAlias",
      "of": "Object",
      "description": "A type alias — a name referring to another type (e.g. ``type UserId = int``, TypeScript ``type``, Rust ``type``)",
      "icon": "Link",
      "color": "#4170d6",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "type alias",
        "typedef",
        "alias",
        "type synonym"
      ]
    },
    {
      "name": "Decorator",
      "of": "Object",
      "description": "A decorator or annotation applied to code elements",
      "icon": "AutoFixHigh",
      "color": "#414dd6",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "decorator",
        "annotation",
        "@",
        "wrapper"
      ]
    },
    {
      "name": "Endpoint",
      "of": "Concept",
      "description": "An API endpoint — a callable HTTP/RPC operation identified by method + path (e.g. ``GET /users/{id}``)",
      "icon": "Http",
      "color": "#7541d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "endpoint",
        "API path",
        "operation",
        "GET",
        "POST"
      ]
    },
    {
      "name": "Route",
      "of": "Object",
      "description": "A URL route or path declaration — the routing rule that maps a request to a handler",
      "icon": "AltRoute",
      "color": "#9241d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "route",
        "URL pattern",
        "path declaration"
      ]
    },
    {
      "name": "Configuration",
      "of": "Object",
      "description": "A configuration setting, environment variable, or config file",
      "icon": "Settings",
      "color": "#b541d6",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "configuration",
        "setting",
        "env var",
        "config"
      ]
    },
    {
      "name": "Specification",
      "of": "Work",
      "description": "A PEP, RFC, standard, or formal specification document",
      "properties": [
        {
          "name": "document_id",
          "display_name": "Document ID",
          "property_type": "text"
        }
      ],
      "icon": "Description",
      "color": "#d641d6",
      "quality_score": 20,
      "requires_named_referent": true,
      "rescue_keywords": [
        "PEP",
        "RFC",
        "specification",
        "standard",
        "enhancement proposal",
        "request for comments"
      ]
    },
    {
      "name": "Design Pattern",
      "of": "Concept",
      "description": "A software design pattern or architectural pattern",
      "icon": "Architecture",
      "color": "#d641b8",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "pattern",
        "design pattern",
        "factory",
        "singleton",
        "observer",
        "strategy"
      ]
    }
  ],
  "templates": {
    "edge_templates": [
      {
        "@type": "EdgeTemplate",
        "id": "system_edge_imports",
        "name": "imports",
        "description": "Module, package, class, or function imports another code element",
        "icon": "Download",
        "color": "#3297cc",
        "quality_score": 15,
        "source_types": [
          "Object",
          "Concept"
        ],
        "target_types": [
          "Object",
          "Concept"
        ],
        "two_endpoints_only": true
      },
      {
        "@type": "EdgeTemplate",
        "id": "system_edge_defines",
        "name": "defines",
        "description": "Module/package/class defines a code element such as class, function, method, type, or constant",
        "icon": "Add",
        "color": "#3267cc",
        "quality_score": 15,
        "source_types": [
          "Object",
          "Concept"
        ],
        "target_types": [
          "Object",
          "Concept"
        ],
        "two_endpoints_only": true
      },
