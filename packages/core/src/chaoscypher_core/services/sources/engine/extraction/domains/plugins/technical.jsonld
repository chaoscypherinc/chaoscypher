  "extraction_limits": {
    "max_relationship_ratio": 6.0,
    "loop_max_entity_count": 30
  },
  "quality_scoring": {
    "default_entity_score": 18,
    "default_relationship_score": 15
  },
  "examples": {
    "alias_examples": [
      {
        "canonical": "requests.Session",
        "aliases": [
          "Session",
          "requests session"
        ],
        "note": "Fully-qualified names and short names become aliases"
      },
      {
        "canonical": "asyncio",
        "aliases": [
          "asyncio module"
        ],
        "note": "Module names are lowercase — preserve original casing"
      }
    ],
    "entity_examples": [
      {
        "line": "E|asyncio|Object||1.0|S1|Module: Python module names are lowercase — this is correct",
        "note": "subtype Module; Python module names are lowercase — this is correct"
      },
      {
        "line": "E|PEP 484|Work||1.0|S1|Specification: PEPs and RFCs are Specification entities",
        "note": "subtype Specification; PEPs and RFCs are Specification entities"
      },
      {
        "line": "E|StopIteration|Object||1.0|S1|Exception: Exception class with PascalCase name",
        "note": "subtype Exception; Exception class with PascalCase name"
      },
      {
        "line": "E|contextmanager|Object||1.0|S1|Decorator: Decorator names are lowercase",
        "note": "subtype Decorator; Decorator names are lowercase"
      }
    ],
    "relationship_examples": [
      {
        "source": "UserService",
        "target": "BaseService",
        "type": "inherits_from",
        "note": "Use inherits_from for class inheritance"
      },
      {
        "source": "PEP 484",
        "target": "typing",
        "type": "specifies",
        "note": "PEP specifies the module it defines"
      },
      {
        "source": "test_login",
        "target": "LoginHandler",
        "type": "tests",
        "note": "Use tests for test-to-code relationships"
      }
    ]
  },
  "title_words": [
