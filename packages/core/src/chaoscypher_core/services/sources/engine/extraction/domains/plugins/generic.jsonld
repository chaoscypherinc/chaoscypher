{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:generic",
  "name": "generic",
  "version": "2.0.0",
  "description": "General-purpose domain for any content that does not match a specialized domain. Flexible entity and relationship types adapt to the source material.",
  "role": "floor",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.0,
  "entity_exclusions": [
    {
      "description": "Pronouns and vague references",
      "examples": [
        "he",
        "she",
        "they",
        "it",
        "someone"
      ]
    },
    {
      "description": "Single common words without specific meaning",
      "examples": [
        "the thing",
        "the item"
      ]
    }
  ],
  "entity_guidance": "EXTRACTION RULES:\n- Extract ALL named entities: people, organizations, places, events, concepts, works\n- TITLES, ROLES AND REFERENCES: An entity this passage calls by a title, a role, a kinship phrase or a description (the margrave, the old duchess, the ferryman's widow, Mamma, her father, the regiment, the capital, the company) is an entity, not a vague reference. If this passage itself names that entity (its name, or a distinctive alias of it, appears in this passage), write that entity's known name as NAME, its known type, and the phrase in aliases (\"Count Oswin Kell rose. The count bowed.\": NAME \"Count Oswin Kell\", alias \"the count\"). A title or kinship word alone ('the count', 'Mamma', 'his wife') never identifies a KNOWN ENTITY: write the phrase as the passage does. Two entries of KNOWN ENTITIES are never one entity: never give one's name as another's alias, and never describe one with the other's facts.\n- Use the most specific entity type available from the templates below\n- Include rich properties: titles, roles, dates, status, descriptions\n- ALIASES: Include alternative names, abbreviations, titles, nicknames\n- PROPERTIES: Extract ALL relevant attributes mentioned in text\n\nDO NOT EXTRACT:\n- Structural markers: page numbers, headers, footers\n- Boilerplate: copyright notices, watermarks",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- Prefer specific relationship types over generic 'related_to'\n- Include justification for each relationship\n- HIERARCHY: Use part_of for compositional relationships, belongs_to and instance_of for classification\n- PEOPLE: Use employee_of, member_of, leader_of and founder_of for professional and institutional ties, mentor_of and student_of for teaching\n- FAMILY AND FRIENDS: Use parent_of, child_of, sibling_of, spouse_of for family ties, friend_of for friendship, rival_of for rivalry\n- PLACE AND TIME: Use located_in, occurred_at and occurred_during; preceded_by and followed_by for sequences\n- EVENTS AND WORKS: Use participates_in, attends and hosts for events; author_of, about, references and mentions for works\n- CAUSAL: Use influences for cause and effect\n",
  "templates": {
    "node_templates": [
      {
        "@type": "NodeTemplate",
        "id": "gen_template_person",
        "name": "Person",
        "description": "An individual human being",
        "icon": "Person",
        "color": "#7d41d6",
        "requires_named_referent": true,
        "quality_score": 25,
        "normalization_keywords": [
          "person",
          "individual",
          "someone named"
        ],
        "properties": [
          {
            "name": "title",
            "display_name": "Title/Role",
            "property_type": "text"
          },
          {
            "name": "occupation",
            "display_name": "Occupation",
            "property_type": "text"
          },
          {
