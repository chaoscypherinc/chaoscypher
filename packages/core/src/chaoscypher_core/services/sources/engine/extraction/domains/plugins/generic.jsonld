  "examples": {
    "alias_examples": [
      {
        "canonical": "United Nations",
        "aliases": [
          "UN",
          "the U.N."
        ],
        "note": "Abbreviations and common short forms become aliases"
      },
      {
        "canonical": "Artificial Intelligence",
        "aliases": [
          "AI",
          "machine intelligence"
        ],
        "note": "Acronyms and synonyms become aliases"
      }
    ],
    "relationship_examples": [
      {
        "source": "John Smith",
        "target": "Acme Corp",
        "type": "employee_of",
        "note": "Use employee_of for employment relationships"
      },
      {
        "source": "Project Alpha",
        "target": "Revenue Growth",
        "type": "influences",
        "note": "Use influences for causal relationships"
      }
    ]
  },
