{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:medical",
  "name": "medical",
  "version": "2.0.0",
  "description": "Medical and clinical documents, healthcare literature, and pharmaceutical information",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.2,
  "entity_exclusions": [
    {
      "description": "Dosage numbers alone",
      "examples": [
        "500mg",
        "2x daily",
        "10ml"
      ]
    },
    {
      "description": "Generic measurements",
      "examples": [
        "normal range",
        "elevated levels",
        "within limits"
      ]
    },
    {
      "description": "Study references",
      "examples": [
        "Figure 1",
        "Table 2",
        "Reference [15]"
      ]
    },
    {
      "description": "Editorial commentary",
      "examples": [
        "it is worth noting",
        "importantly"
      ]
    }
  ],
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "clinical_core": {
        "terms": [
          "diagnosis",
          "treatment",
          "symptoms",
          "patient",
          "clinical",
          "prognosis",
          "medical",
          "healthcare",
          "disease",
          "disorder",
          "syndrome"
        ],
        "weight": 1.2
      },
      "pharmaceutical": {
        "terms": [
          "dosage",
          "mg",
          "prescribed",
          "contraindicated",
          "adverse effect",
          "drug",
          "medication",
          "pharmaceutical",
          "FDA",
          "indication",
          "formulation"
        ],
        "weight": 1.0
      },
      "diagnostic": {
        "terms": [
          "test",
          "imaging",
          "biopsy",
          "MRI",
          "CT scan",
          "blood test",
          "screening",
          "examination",
          "differential diagnosis",
          "laboratory"
        ],
        "weight": 0.9
      },
      "anatomy": {
        "terms": [
          "cardiac",
          "pulmonary",
          "hepatic",
          "renal",
          "neurological",
          "gastrointestinal",
          "musculoskeletal",
          "endocrine",
          "cardiovascular"
        ],
        "weight": 0.8
      },
      "procedures": {
        "terms": [
          "surgery",
          "procedure",
          "intervention",
          "therapy",
          "operation",
          "transplant",
          "catheterization",
          "endoscopy"
        ],
        "weight": 0.9
      },
      "clinical_terms": {
        "terms": [
          "etiology",
          "pathology",
          "pathogenesis",
          "epidemiology",
          "morbidity",
          "mortality",
          "incidence",
          "prevalence",
          "comorbidity"
        ],
        "weight": 0.8
      }
    },
    "file_extensions": [
      ".pdf"
    ],
    "doc_types": [
      "medical_document",
      "clinical_record",
      "pharmaceutical"
    ],
    "patterns": [
      {
        "regex": "(?i)\\b\\d+\\s*(mg|mcg|ml|iu|kg|mmol|units?)\\b",
        "weight": 1.4,
        "description": "Dosage notation"
      },
      {
        "regex": "(?i)\\bICD-?(10|11)?[-:]?[A-Z]\\d+",
        "weight": 1.5,
        "description": "ICD code pattern"
      },
      {
        "regex": "(?i)\\b(q\\.?d\\.?|b\\.?i\\.?d\\.?|t\\.?i\\.?d\\.?|q\\.?i\\.?d\\.?|p\\.?r\\.?n\\.?|p\\.?o\\.?|i\\.?v\\.?|i\\.?m\\.?)\\b",
        "weight": 1.3,
        "description": "Prescription abbreviations"
      },
      {
        "regex": "(?i)\\b(stage|grade|class|type)\\s+[IVXivx\\d]+[a-d]?\\b",
        "weight": 1.2,
        "description": "Disease staging/classification"
      },
      {
        "regex": "(?i)\\b(diagnosis|dx|treatment|tx|prognosis|history|hx)\\b",
        "weight": 1.0,
        "description": "Clinical abbreviations"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.1,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract conditions, symptoms, treatments, drugs, procedures, and anatomical locations\n- Include dosage information as properties on drug entities\n- Use standardized medical terminology when possible\n\nDO NOT EXTRACT:\n- Dosage numbers alone: '500mg', '2x daily' (attach to drug entity as property)\n- Generic measurements: 'normal range', 'elevated levels' (without specific values)\n- Study references: Figure 1, Table 2, Reference [15]\n- Administrative codes as standalone entities: ICD-10, CPT codes (record them as a code property of their condition or procedure)",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- CAUSATION: Link conditions to causes with causes relationship\n- TREATMENT: Connect drugs/procedures to conditions with treats\n- INTERACTIONS: Capture drug interactions with interacts_with, contraindicated_with\n- ANATOMY: Link conditions/symptoms to anatomical locations with affects\n",
  "subtypes": [
    {
      "name": "Condition",
      "of": "Concept",
      "description": "A disease, disorder, syndrome, or medical condition",
      "properties": [
        {
          "name": "severity",
          "display_name": "Severity",
          "property_type": "text"
        },
        {
          "name": "stage",
          "display_name": "Stage",
          "property_type": "text"
        }
      ],
      "icon": "Coronavirus",
      "color": "#7041d6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "a disease",
        "disorder",
        "condition",
        "syndrome",
        "illness",
        "diagnosed with",
        "suffers from",
        "presents with"
      ]
    },
    {
      "name": "Symptom",
      "of": "Concept",
      "description": "A clinical symptom, sign, or manifestation",
      "icon": "MonitorHeart",
      "color": "#a541d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "symptom",
        "presents with",
        "clinical sign",
        "manifestation",
        "complains of",
        "experiences"
      ]
    },
    {
      "name": "Treatment",
      "of": "Concept",
      "description": "A therapeutic intervention or treatment approach",
      "icon": "Healing",
      "color": "#d641d3",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "treatment",
        "therapy",
        "intervention",
        "management of",
        "treated with",
        "therapeutic approach"
      ]
    },
    {
      "name": "Drug",
      "of": "Object",
      "description": "A pharmaceutical compound or medication",
      "properties": [
        {
          "name": "dosage_form",
          "display_name": "Dosage Form",
          "property_type": "text"
        },
        {
          "name": "route",
          "display_name": "Route of Administration",
          "property_type": "text"
        },
        {
          "name": "mechanism",
          "display_name": "Mechanism of Action",
          "property_type": "text"
        }
      ],
      "icon": "Medication",
      "color": "#d6419f",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "drug",
        "medication",
        "pharmaceutical",
        "administered",
        "prescribed",
        "compound"
      ]
    },
    {
      "name": "Procedure",
      "of": "Concept",
      "description": "A medical or surgical procedure",
      "icon": "LocalHospital",
      "color": "#d6416a",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "procedure",
        "surgery",
        "operation",
        "intervention",
        "performed"
      ]
    },
    {
      "name": "Diagnostic Test",
      "of": "Concept",
      "description": "A diagnostic test, imaging, or laboratory test",
      "icon": "Biotech",
      "color": "#d64d41",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "test",
        "diagnostic",
        "imaging",
        "laboratory test",
        "screening",
        "biopsy"
      ]
    },
    {
      "name": "Anatomy",
      "of": "Object",
      "description": "A body part, organ, or anatomical structure",
      "icon": "Accessibility",
      "color": "#d68241",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "organ",
        "tissue",
        "body part",
        "anatomical structure",
        "system",
        "gland"
      ]
    },
    {
      "name": "Pathogen",
      "of": "Object",
      "description": "A disease-causing organism (virus, bacteria, etc.)",
      "icon": "BugReport",
      "color": "#d6b641",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "pathogen",
        "virus",
        "bacteria",
        "organism",
        "infection caused by"
      ]
    },
    {
      "name": "Clinical Trial",
      "of": "Event",
      "description": "A clinical research study or trial",
      "icon": "Science",
      "color": "#c2d641",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "clinical trial",
        "trial",
        "study",
        "randomized controlled trial",
        "phase",
        "RCT"
      ]
    },
    {
      "name": "Dosage",
      "of": "Concept",
      "description": "A drug dosage or administration regimen",
      "icon": "Scale",
      "color": "#8dd641",
      "quality_score": 15,
      "requires_named_referent": false
    },
    {
      "name": "Side Effect",
      "of": "Concept",
      "description": "An adverse effect or side effect of treatment",
      "icon": "Warning",
      "color": "#59d641",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "side effect",
        "adverse effect",
        "adverse reaction",
        "adverse event"
      ]
    },
    {
      "name": "Risk Factor",
      "of": "Concept",
      "description": "A risk factor for a condition",
      "icon": "GppMaybe",
      "color": "#41d65e",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "risk factor",
        "risk",
        "predisposition",
        "susceptibility",
        "predisposing factor"
      ]
    },
    {
      "name": "Gene",
      "of": "Object",
      "description": "A gene, allele, mutation, or genetic locus (e.g. BRCA1, TP53)",
      "icon": "DataObject",
      "color": "#41d693",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "gene",
        "allele",
        "mutation",
        "polymorphism",
        "locus"
      ]
    },
    {
      "name": "Biomarker",
      "of": "Concept",
      "description": "A measurable biological indicator used for diagnosis, prognosis, or treatment response (e.g. PSA, HbA1c)",
      "icon": "Biotech",
      "color": "#41d6b3",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "biomarker",
        "genetic marker",
        "indicator",
        "marker"
      ]
    },
    {
      "name": "Patient Population",
      "of": "Group",
      "description": "A defined patient group or demographic",
      "icon": "Groups",
      "color": "#41d6c8",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "population",
        "cohort",
        "patient group",
        "demographic",
        "subjects"
      ]
    },
    {
      "name": "Guideline",
      "of": "Work",
      "description": "A clinical guideline or recommendation (e.g. ADA guideline, USPSTF recommendation)",
      "icon": "Description",
      "color": "#41b0d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "guideline",
        "recommendation",
        "best practice",
        "standard of care"
      ]
    },
    {
      "name": "Protocol",
      "of": "Concept",
      "description": "A clinical protocol — a procedural sequence (e.g. CHOP, ATLS) used during treatment or research",
      "icon": "ListAlt",
      "color": "#418cd6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "protocol",
        "regimen",
        "procedure sequence"
      ]
    },
    {
      "name": "Outcome",
      "of": "Concept",
      "description": "A clinical outcome — what actually happened to a patient or population (mortality, remission, recovery)",
      "icon": "Assessment",
      "color": "#417cd6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "outcome",
        "result",
        "survival",
        "mortality"
      ]
    },
    {
      "name": "Endpoint",
      "of": "Concept",
      "description": "A pre-specified endpoint in a clinical trial (primary, secondary; surrogate or hard) used to measure efficacy",
      "icon": "Flag",
      "color": "#4163d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "endpoint",
        "primary endpoint",
        "secondary endpoint",
        "efficacy",
        "response rate"
      ]
    },
    {
      "name": "Mechanism of Action",
      "of": "Concept",
      "description": "A biological mechanism or pathway",
      "icon": "AccountTree",
      "color": "#4147d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "mechanism",
        "pathway",
        "action",
        "receptor",
        "cascade"
      ]
    }
  ],
  "templates": {
    "edge_templates": [
      {
        "@type": "EdgeTemplate",
        "id": "med_edge_causes",
        "name": "causes",
        "description": "An agent (pathogen, drug, condition, risk factor, procedure, treatment, gene, etc.) causes a clinical effect (condition, symptom, side effect, outcome, biomarker change)",
        "icon": "TrendingUp",
        "color": "#32cc36",
        "quality_score": 25,
        "source_types": [
          "Object",
          "Concept"
        ],
        "target_types": [
          "Concept"
        ],
        "two_endpoints_only": true
      },
      {
