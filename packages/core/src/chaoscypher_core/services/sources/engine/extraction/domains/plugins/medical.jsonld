      {
        "@type": "EdgeTemplate",
        "id": "med_edge_mechanism_of",
        "name": "mechanism_of",
        "description": "A biological mechanism, pathway, or gene underlies a drug action, treatment, condition, symptom, side effect, or biomarker",
        "icon": "AccountTree",
        "color": "#8bcc32",
        "quality_score": 15,
        "source_types": [
