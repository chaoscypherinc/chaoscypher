{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:legal",
  "name": "legal",
  "version": "2.0.0",
  "description": "Legal documents, court cases, statutes, contracts, and regulations",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.25,
  "entity_exclusions": [
    {
      "description": "Procedural boilerplate",
      "examples": [
        "hereby",
        "whereas",
        "notwithstanding",
        "witnesseth"
      ]
    },
    {
      "description": "Citation formatting",
      "examples": [
        "Id.",
        "supra",
        "infra",
        "op. cit."
      ]
    }
  ],
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "legal_core": {
        "terms": [
          "plaintiff",
          "defendant",
          "court",
          "statute",
          "jurisdiction",
          "precedent",
          "ruling",
          "judgment",
          "verdict",
          "appeal",
          "litigation",
          "lawsuit"
        ],
        "weight": 1.2
      },
      "contract": {
        "terms": [
          "hereby",
          "whereas",
          "party",
          "agreement",
          "liable",
          "covenant",
          "indemnify",
          "warrant",
          "breach",
          "termination",
          "obligation",
          "consideration"
        ],
        "weight": 1.0
      },
      "procedural": {
        "terms": [
          "motion",
          "hearing",
          "filing",
          "discovery",
          "deposition",
          "subpoena",
          "injunction",
          "writ",
          "summons",
          "pleading"
        ],
        "weight": 0.9
      },
      "legal_concepts": {
        "terms": [
          "liability",
          "negligence",
          "damages",
          "tort",
          "remedy",
          "standing",
          "due process",
          "constitutional",
          "rights",
          "duties"
        ],
        "weight": 0.8
      },
      "legal_actors": {
        "terms": [
          "judge",
          "attorney",
          "counsel",
          "prosecutor",
          "lawyer",
          "magistrate",
          "jury",
          "witness",
          "claimant"
        ],
        "weight": 0.8
      },
      "citations": {
        "terms": [
          "v.",
          "vs.",
          "U.S.C.",
          "F.2d",
          "F.3d",
          "S.Ct.",
          "L.Ed.",
          "Cal.",
          "N.Y."
        ],
        "weight": 1.3
      }
    },
    "file_extensions": [
      ".pdf",
      ".docx"
    ],
    "doc_types": [
      "legal_document",
      "court_filing",
      "contract"
    ],
    "patterns": [
      {
        "regex": "\\b[A-Z][a-z]+\\s+v\\.?\\s+[A-Z][a-z]+\\b",
        "weight": 1.5,
        "description": "Case citation pattern"
      },
      {
        "regex": "(?i)\\b\\d+\\s+U\\.?S\\.?C\\.?\\s+\\d+\\b",
        "weight": 1.4,
        "description": "USC citation"
      },
      {
        "regex": "(?i)\\b(whereas|hereby|witnesseth|wherefore|herein|therein|thereof|hereto)\\b",
        "weight": 1.3,
        "description": "Contract/legal language"
      },
      {
        "regex": "(?i)\\b(section|article|paragraph|clause)\\s+\\d+(\\.\\d+)*\\b",
        "weight": 1.0,
        "description": "Section references"
      },
      {
        "regex": "(?i)\\b(plaintiff|defendant|petitioner|respondent)\\b",
        "weight": 1.2,
        "description": "Party designations"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.05,
      "extension_boost": 0.1,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract statutes, cases, legal doctrines, courts, and named parties\n- Use official case citations and names\n- Include jurisdiction and date in properties\n\nDO NOT EXTRACT:\n- Procedural boilerplate: 'hereby', 'whereas', 'notwithstanding'\n- Citation formatting: Id., supra, infra, op. cit.",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- PRECEDENT: Capture citation chains with cites, overrules, affirms\n- PARTIES: Extract all named parties with party_to relationship\n- DOCTRINE: Link cases to legal doctrines they establish or apply\n- HIERARCHY: Use adjudicates to connect courts to cases\n",
  "subtypes": [
    {
      "name": "Statute",
      "of": "Work",
      "description": "A law enacted by a legislative body",
      "icon": "MenuBook",
      "color": "#41c7d6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "a statute",
        "the law",
        "enacted by",
        "legislative act",
        "code section",
        "act of",
        "legislation"
      ]
    },
    {
      "name": "Case",
      "of": "Event",
      "description": "A legal case or court decision",
      "properties": [
        {
          "name": "date_decided",
          "display_name": "Date Decided",
          "property_type": "date"
        },
        {
          "name": "jurisdiction",
          "display_name": "Jurisdiction",
          "property_type": "text"
        },
        {
          "name": "citation",
          "display_name": "Citation",
          "property_type": "text"
        }
      ],
      "icon": "Gavel",
      "color": "#4192d6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "the case",
        "court held",
        "ruling in",
        "decision in",
        "v.",
        "vs.",
        "matter of"
      ]
    },
    {
      "name": "Legal Doctrine",
      "of": "Concept",
      "description": "An established legal principle or rule",
      "icon": "Lightbulb",
      "color": "#415ed6",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "doctrine",
        "legal principle",
        "rule that",
        "established that",
        "holding that"
      ]
    },
    {
      "name": "Court",
      "of": "Organization",
      "description": "A judicial body or tribunal",
      "icon": "AccountBalance",
      "color": "#5941d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "the court",
        "supreme court",
        "appellate court",
        "tribunal",
        "district court",
        "circuit court"
      ]
    },
    {
      "name": "Party",
      "of": "Person",
      "description": "A person or entity in legal proceedings",
      "properties": [
        {
          "name": "role",
          "display_name": "Role",
          "property_type": "text"
        }
      ],
      "icon": "Person",
      "color": "#8e41d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "plaintiff",
        "defendant",
        "petitioner",
        "respondent",
        "appellant",
        "appellee",
        "party to"
      ]
    },
    {
      "name": "Jurisdiction",
      "of": "Location",
      "description": "A legal authority or territory",
      "icon": "Public",
      "color": "#c241d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "jurisdiction",
        "state",
        "federal",
        "territory",
        "venue",
        "district"
      ]
    },
    {
      "name": "Contract",
      "of": "Work",
      "description": "A legally binding agreement",
      "icon": "Description",
      "color": "#d641b6",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "agreement",
        "contract",
        "covenant",
        "binding agreement",
        "parties agree"
      ]
    },
    {
      "name": "Regulation",
      "of": "Work",
      "description": "An administrative rule or regulation",
      "icon": "Policy",
      "color": "#d64181",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "regulation",
        "administrative rule",
        "CFR",
        "regulatory requirement"
      ]
    },
    {
      "name": "Legal Term",
