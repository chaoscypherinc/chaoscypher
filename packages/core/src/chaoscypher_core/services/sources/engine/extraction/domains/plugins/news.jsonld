        "icon": "Article",
        "color": "#cc6c32",
        "quality_score": 15,
        "source_types": [
          "Organization",
          "Person"
        ],
        "target_types": [
          "Event",
          "Work",
          "Concept",
          "Location",
          "Person",
          "Organization"
        ],
        "two_endpoints_only": true
      },
      {
