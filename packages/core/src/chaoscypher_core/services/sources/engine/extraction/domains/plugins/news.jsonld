{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:news",
  "name": "news",
  "version": "2.0.0",
  "description": "News articles, journalism, press releases, and current events",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 0.95,
  "type_aliases": {
    "Suspect": "Person",
    "Victim": "Person",
    "Stakeholder": "Person"
  },
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "news_core": {
        "terms": [
          "breaking news",
          "developing story",
          "sources say",
          "according to a source",
          "wire service",
          "press conference",
          "according to officials",
          "according to authorities",
          "according to the report"
        ],
        "weight": 1.2
      },
      "journalism": {
        "terms": [
          "journalist",
          "reporter",
          "correspondent",
          "newsroom",
          "newspaper",
          "wire service",
          "Associated Press",
          "Reuters",
          "AFP",
          "told reporters",
          "spokesperson said",
          "spokesman said",
          "spokeswoman said"
        ],
        "weight": 1.0
      },
      "attribution": {
        "terms": [
          "officials said",
          "authorities said",
          "the agency said",
          "in a statement",
          "issued a statement",
          "police said",
          "the spokesperson",
          "responding to questions",
          "no comment",
          "declined to comment"
        ],
        "weight": 0.9
      },
      "structure": {
        "terms": [
          "headline",
          "dateline",
          "byline",
          "press release",
          "lede"
        ],
        "weight": 1.0
      },
      "time_markers": {
        "terms": [
          "on Monday",
          "on Tuesday",
          "on Wednesday",
          "on Thursday",
          "on Friday"
        ],
        "weight": 0.7
      },
      "disaster_response": {
        "terms": [
          "evacuated",
          "first responders",
          "emergency services",
          "death toll",
          "displaced",
          "casualties",
          "search and rescue",
          "state of emergency",
          "in response to the"
        ],
        "weight": 1.0
      }
    },
    "file_extensions": [],
    "doc_types": [
      "news_article",
      "press_release",
      "journalism"
    ],
    "patterns": [
      {
        "regex": "(?m)^[A-Z][A-Z .,'’]+\\s*[-–—]\\s",
        "weight": 1.3,
        "description": "Dateline pattern (CITY -)"
      },
      {
        "regex": "(?i)\\baccording\\s+to\\s+[A-Z]",
        "weight": 1.2,
        "description": "Source attribution"
      },
      {
        "regex": "\\b(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\\b",
        "weight": 0.8,
        "description": "Day references"
      },
      {
        "regex": "(?i)\\b\\d{1,2}:\\d{2}\\s*(am|pm|a\\.?m\\.?|p\\.?m\\.?)?\\b",
        "weight": 0.9,
        "description": "Time stamps"
      },
      {
        "regex": "\\b(?:BREAKING|EXCLUSIVE|UPDATE|DEVELOPING|JUST\\s+IN)\\b|(?i:\\bbreaking\\s+news\\b)",
        "weight": 1.1,
        "description": "News urgency markers"
      },
      {
        "regex": "\\b(?:Reuters|REUTERS|Associated\\s+Press|AP|AFP)\\b",
        "weight": 1.4,
        "description": "Wire service attribution"
      },
      {
        "regex": "(?i)\\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\s*,\\s*(january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\d{1,2},?\\s+\\d{4}",
        "weight": 1.8,
        "description": "Wikinews-style dateline (Day, Month DD, YYYY)"
      },
      {
        "regex": "(?i)\\b(killed|injured|wounded|displaced)\\s+(at\\s+least\\s+)?[\\d,]+",
        "weight": 1.5,
        "description": "Casualty count language"
      },
      {
        "regex": "\\b(USA Today|New York Times|Washington Post|BBC|CNN|Globe and Mail|TVNZ|NHK|Al Jazeera|Bloomberg|The Guardian)\\b",
        "weight": 1.3,
        "description": "Named news outlets"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.0,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_exclusions": [
    {
      "description": "Wire service boilerplate",
      "examples": [
        "CITY (AP) -"
      ]
    },
    {
      "description": "Editorial markers",
      "examples": [
        "breaking",
        "developing",
        "update",
        "exclusive"
      ]
    }
  ],
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract news events, people, organizations, locations, and sources\n- Capture both named and anonymous sources as Source entities\n- Include dates and locations in properties\n- A social media handle (@username) is an alias of the person or organization it belongs to\n\nDO NOT EXTRACT:\n- Wire service boilerplate: 'CITY (AP) -', bylines, datelines as entities\n- Editorial markers: 'breaking', 'developing', 'update'",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- ATTRIBUTION: Link quotes to speakers with quoted_as_saying\n- EVENTS: Connect people/organizations to events with involves\n- TIMELINE: Use occurred_at to link events to dates/times\n",
  "subtypes": [
    {
      "name": "News Event",
      "of": "Event",
      "description": "A newsworthy event or occurrence",
      "properties": [
        {
          "name": "date",
          "display_name": "Date",
          "property_type": "date"
        },
        {
          "name": "severity",
          "display_name": "Severity",
          "property_type": "text"
        }
      ],
      "icon": "Newspaper",
      "color": "#41d6a5",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "event",
        "incident",
        "occurred",
        "happened",
        "took place",
        "breaking",
        "developing"
      ]
    },
    {
      "name": "Quote",
      "of": "Work",
      "description": "A direct quotation from a source",
      "icon": "FormatQuote",
      "color": "#4160d6",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "quote",
        "said",
        "stated",
        "commented",
        "remarked"
      ]
    },
    {
      "name": "Source",
      "of": "Person",
      "description": "An information source (named or anonymous)",
      "icon": "ContactPhone",
      "color": "#5b41d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "source",
        "according to",
        "reported by",
        "confirmed by",
        "official said"
      ]
    },
    {
      "name": "Date",
      "of": "Event",
      "description": "When the event occurred",
      "icon": "CalendarMonth",
      "color": "#ca41d6",
      "quality_score": 15,
      "requires_named_referent": false
    },
    {
      "name": "Statement",
      "of": "Work",
      "description": "An official statement or announcement",
      "icon": "Campaign",
      "color": "#d641aa",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "statement",
        "announcement",
        "press release",
        "official statement"
      ]
    },
    {
      "name": "Publication",
      "of": "Organization",
      "description": "A news outlet or publication",
      "icon": "Article",
      "color": "#d64841",
      "quality_score": 15,
      "requires_named_referent": true
    },
    {
      "name": "Policy",
      "of": "Concept",
      "description": "A government policy or official stance directing action",
      "icon": "Flag",
      "color": "#d68041",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "policy",
        "directive",
        "guideline"
      ]
    },
    {
      "name": "Regulation",
      "of": "Work",
      "description": "An enforceable regulation, rule, mandate, or executive order",
      "icon": "Gavel",
      "color": "#d6a041",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "regulation",
        "rule",
        "mandate",
        "order",
        "executive order"
      ]
    },
    {
      "name": "Investigation",
      "of": "Event",
      "description": "A criminal, congressional, or journalistic investigation",
      "icon": "Search",
      "color": "#d6b841",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "investigation",
        "probe",
        "inquiry",
        "audit"
      ]
    },
    {
      "name": "Legal Action",
      "of": "Event",
      "description": "A lawsuit, indictment, or legal proceeding",
      "icon": "Balance",
      "color": "#bdd641",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "lawsuit",
        "indictment",
        "trial",
        "charges",
        "legal action"
      ]
    },
    {
      "name": "Government Agency",
      "of": "Organization",
      "description": "A government agency or department",
      "icon": "AccountBalance",
      "color": "#41d66d",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "agency",
        "department",
        "bureau",
        "ministry",
        "commission"
      ]
    }
  ],
  "core_properties": {
    "Person": [
      {
        "name": "title",
        "display_name": "Title",
        "property_type": "text"
      },
      {
        "name": "organization",
        "display_name": "Organization",
        "property_type": "text"
      },
      {
        "name": "role",
        "display_name": "Role",
        "property_type": "text"
      }
    ]
  },
  "core_rescue_keywords": {
    "Person": [
      "person",
      "individual",
      "official",
      "spokesperson",
      "witness"
    ],
    "Organization": [
      "company",
      "organization",
      "government",
      "agency",
      "group",
      "corporation"
    ],
    "Location": [
      "location",
      "city",
      "country",
      "place",
      "at",
      "in"
    ]
  },
  "templates": {
