  "extraction_limits": {
    "max_relationship_ratio": 5.0,
    "loop_max_entity_count": 25
  },
  "quality_scoring": {
    "default_entity_score": 18,
    "default_relationship_score": 15
  },
  "examples": {
    "alias_examples": [
      {
        "canonical": "Federal Bureau of Investigation",
        "aliases": [
          "FBI",
          "the Bureau"
        ],
        "note": "Abbreviations and common references become aliases"
      },
      {
        "canonical": "President Biden",
        "aliases": [
          "Joe Biden",
          "Biden",
          "POTUS"
        ],
        "note": "Full names and acronyms become aliases"
      }
    ],
    "relationship_examples": [
      {
        "source": "DOJ",
        "target": "Tech Company",
        "type": "investigated",
        "note": "Use investigated for probes and inquiries"
      },
      {
        "source": "Senator Smith",
        "target": "Policy X",
        "type": "criticized",
        "note": "Use criticized for public opposition"
      }
    ]
  },
  "title_words": [
    "mr",
    "mrs",
    "ms",
    "miss",
    "dr",
    "sir",
    "dame",
    "madam",
    "the",
    "of",
    "de",
    "von",
    "van",
    "president",
    "senator",
    "governor",
    "minister",
    "colonel",
    "captain",
    "general"
  ],
  "content_exclusions": {
    "categories": [
      "legal",
      "boilerplate",
      "advertising",
      "web_artifacts",
      "metadata"
    ]
  },
  "extraction_filtering_mode": "minimal",
  "icon": "Newspaper"
}
