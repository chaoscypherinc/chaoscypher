        "icon": "ThumbDown",
        "color": "#9232cc",
        "quality_score": 25,
        "source_types": [
          "Concept",
          "Event",
          "Work"
        ],
        "target_types": [
          "Concept"
        ],
        "symmetric": true,
        "two_endpoints_only": true
      },
