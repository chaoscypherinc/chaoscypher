{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:scientific",
  "name": "scientific",
  "version": "2.0.0",
  "description": "Scientific research papers, studies, experiments, and academic publications",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.3,
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "research_core": {
        "terms": [
          "hypothesis",
          "experiment",
          "methodology",
          "results",
          "conclusion",
          "abstract",
          "study",
          "research",
          "investigation",
          "analysis",
          "findings"
        ],
        "weight": 1.2
      },
      "statistics": {
        "terms": [
          "p-value",
          "significance",
          "correlation",
          "regression",
          "sample size",
          "confidence interval",
          "standard deviation",
          "variance",
          "null hypothesis",
          "statistical",
          "mean",
          "median"
        ],
        "weight": 1.0
      },
      "scientific_method": {
        "terms": [
          "control group",
          "experimental group",
          "variable",
          "independent variable",
          "dependent variable",
          "randomized",
          "double-blind",
          "placebo",
          "replication",
          "peer-reviewed"
        ],
        "weight": 1.0
      },
      "publication": {
        "terms": [
          "journal",
          "citation",
          "DOI",
          "peer-reviewed",
          "published",
          "authors",
          "references",
          "bibliography",
          "supplementary",
          "appendix"
        ],
        "weight": 0.8
      },
      "disciplines": {
        "terms": [
          "biology",
          "chemistry",
          "physics",
          "neuroscience",
          "psychology",
          "ecology",
          "genetics",
          "biochemistry",
          "molecular",
          "cellular",
          "computational"
        ],
        "weight": 0.6
      },
      "data_terms": {
        "terms": [
          "dataset",
          "data collection",
          "measurements",
          "observations",
          "quantitative",
          "qualitative",
          "empirical",
          "protocol",
          "procedure"
        ],
        "weight": 0.8
      },
      "physics_concepts": {
        "terms": [
          "electron",
          "proton",
          "neutron",
          "photon",
          "quantum",
          "electromagnetic",
          "wavelength",
          "frequency",
          "nucleus",
          "orbital",
          "subatomic",
          "thermodynamic",
          "kinetic energy",
          "potential energy",
          "gravitational",
          "magnetic field",
          "electric field",
          "radioactive",
          "superconductor",
          "relativity",
          "wave function",
          "atomic number",
          "atomic mass",
          "elementary particle"
        ],
        "weight": 1.0
      },
      "chemistry_concepts": {
        "terms": [
          "chemical bond",
          "compound",
          "isotope",
          "valence",
          "periodic table",
          "catalyst",
          "oxidation",
          "covalent",
          "ionic bond",
          "stoichiometry",
          "molar mass",
          "chemical reaction",
          "molecular structure"
        ],
        "weight": 0.9
      },
      "biology_concepts": {
        "terms": [
          "DNA",
          "RNA",
          "genome",
          "chromosome",
          "enzyme",
          "photosynthesis",
          "mitosis",
          "natural selection",
          "ecosystem",
          "metabolism",
          "ribosome",
          "organelle",
          "cell membrane"
        ],
        "weight": 0.8
      }
    },
    "file_extensions": [
      ".pdf"
    ],
    "doc_types": [
      "academic_paper",
      "research_article",
      "scientific_publication"
    ],
    "patterns": [
      {
        "regex": "(?i)\\b(p\\s*[<>=]\\s*0\\.\\d+)\\b",
        "weight": 1.5,
        "description": "P-value notation"
      },
      {
        "regex": "(?i)\\b(n\\s*=\\s*\\d+)\\b",
        "weight": 1.3,
        "description": "Sample size notation"
      },
      {
        "regex": "(?i)\\b(et\\s+al\\.?)\\b",
        "weight": 1.2,
        "description": "Citation pattern"
      },
      {
        "regex": "(?i)\\b(doi:|DOI:)\\s*10\\.\\d+",
        "weight": 1.4,
        "description": "DOI pattern"
      },
      {
        "regex": "(?i)\\b(figure|fig\\.|table)\\s+\\d+",
        "weight": 1.0,
        "description": "Figure/Table references"
      },
      {
        "regex": "(?i)\\b(abstract|methods|results|discussion|conclusion|references|introduction)\\s*:",
        "weight": 1.3,
        "description": "Paper section headers"
      },
      {
        "regex": "\\d+\\.?\\d*\\s*[×x]\\s*10",
        "weight": 1.3,
        "description": "Scientific notation"
      },
      {
        "regex": "(?i)\\b\\d+\\.?\\d*\\s*(eV|keV|MeV|GeV|nm|pm|amu|Hz|GHz|MHz|m/s|km/s)\\b",
        "weight": 1.2,
        "description": "Physics units"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.1,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_exclusions": [
    {
      "description": "Figure and table references",
      "examples": [
        "Figure 1",
        "Table S2",
        "Supplementary Figure S3"
      ]
    },
    {
      "description": "Statistical notation as entities",
      "examples": [
        "p < 0.05",
        "n = 100",
        "CI 95%"
      ]
    },
    {
      "description": "Generic labels",
      "examples": [
        "this study",
        "the results",
        "our findings",
        "the data"
      ]
    },
    {
      "description": "Citation markers",
      "examples": [
        "[1]",
        "(Smith et al., 2020)",
        "et al."
      ]
    }
  ],
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract hypotheses, experiments, findings, researchers, and publications\n- Include specific study names, methodology descriptions\n- Extract variables (independent, dependent, controlled)\n\nDO NOT EXTRACT:\n- Figure/table references: Figure 1, Table 2, Supplementary Figure S3\n- Statistical notation as entities: p < 0.05, n = 100, CI 95%\n- Generic labels: 'this study', 'our results', 'the data'\n- Page numbers, DOIs, or formatting markers",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- HYPOTHESIS-EVIDENCE: Link findings to hypotheses with supports/contradicts\n- METHODOLOGY: Capture methods and link experiments with uses_method\n- CITATIONS: Extract cites relationships between publications\n- VARIABLES: Identify independent/dependent variables with measures relationship\n",
  "subtypes": [
    {
      "name": "Hypothesis",
      "of": "Concept",
      "description": "A testable prediction or theoretical claim",
      "icon": "Lightbulb",
      "color": "#d67441",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "a hypothesis",
        "we hypothesize",
        "predicts that",
        "proposed that",
        "hypothesized",
        "prediction that"
      ]
    },
    {
      "name": "Experiment",
      "of": "Event",
      "description": "A scientific study, trial, or investigation",
      "properties": [
        {
          "name": "sample_size",
          "display_name": "Sample Size",
          "property_type": "text"
        },
        {
          "name": "duration",
          "display_name": "Duration",
          "property_type": "text"
        }
      ],
      "icon": "Science",
      "color": "#d6a941",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "an experiment",
        "study design",
        "we conducted",
        "trial of",
        "investigation of",
        "experimental study"
      ]
    },
    {
      "name": "Method",
      "of": "Concept",
      "description": "A research methodology, technique, or protocol",
      "icon": "Build",
      "color": "#cfd641",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "methodology",
        "procedure",
        "protocol",
        "technique used",
        "method of",
        "approach"
      ]
    },
    {
      "name": "Finding",
      "of": "Concept",
      "description": "A research result, observation, or discovery",
      "icon": "Insights",
      "color": "#9bd641",
      "quality_score": 25,
      "requires_named_referent": false,
      "rescue_keywords": [
        "finding",
        "result shows",
        "we found",
        "data indicates",
        "observation",
        "discovered that",
        "results demonstrate"
      ]
    },
    {
      "name": "Dataset",
      "of": "Work",
      "description": "A collection of data used or produced in research",
      "icon": "Storage",
      "color": "#66d641",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "dataset",
        "data collected",
        "sample of",
        "corpus of",
        "collection of measurements"
      ]
    },
    {
      "name": "Variable",
      "of": "Concept",
      "description": "An independent, dependent, or control variable",
      "icon": "Tune",
      "color": "#41d651",
      "quality_score": 18,
      "requires_named_referent": false,
      "rescue_keywords": [
        "variable",
        "factor",
        "measured",
        "controlled for",
        "independent variable",
        "dependent variable"
      ]
    },
    {
      "name": "Theory",
      "of": "Concept",
      "description": "A well-substantiated scientific explanation",
      "icon": "AutoAwesome",
      "color": "#41d686",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "theory of",
        "theoretical framework",
        "model predicts",
        "explains that"
      ]
    },
    {
      "name": "Model",
      "of": "Concept",
      "description": "A mathematical or conceptual representation",
      "icon": "Hub",
      "color": "#41d6ba",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "model",
        "mathematical model",
        "computational model",
        "simulation",
        "framework"
      ]
    },
    {
      "name": "Researcher",
      "of": "Person",
      "description": "A scientist, author, or research team",
      "properties": [
        {
          "name": "affiliation",
          "display_name": "Affiliation",
          "property_type": "text"
        },
        {
          "name": "specialization",
          "display_name": "Specialization",
          "property_type": "text"
        }
      ],
      "names_a_person": true,
      "icon": "Person",
      "color": "#41bed6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "researcher",
        "author",
        "scientist",
        "investigator",
        "study team"
      ]
    },
    {
      "name": "Publication",
      "of": "Work",
      "description": "A scientific paper, article, or preprint",
      "icon": "Article",
      "color": "#4189d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "paper",
        "article",
        "study",
        "publication",
        "preprint"
      ]
    },
    {
      "name": "Field",
      "of": "Concept",
      "description": "A scientific discipline or subdiscipline",
      "icon": "Category",
      "color": "#4154d6",
      "quality_score": 15,
      "requires_named_referent": false
    },
    {
      "name": "Institution",
      "of": "Organization",
      "description": "A research institution, university, or lab",
      "icon": "School",
      "color": "#6341d6",
      "quality_score": 15,
      "requires_named_referent": true
    },
    {
      "name": "Organism",
      "of": "Object",
      "description": "An individual biological organism, strain, or specimen (e.g. ``E. coli K-12``, ``zebrafish AB strain``)",
      "icon": "Biotech",
      "color": "#9741d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "organism",
        "strain",
        "specimen",
        "model organism"
      ]
    },
    {
      "name": "Species",
      "of": "Concept",
      "description": "A species or higher taxonomic group (e.g. ``Homo sapiens``, ``Drosophila melanogaster``)",
      "icon": "AccountTree",
      "color": "#b441d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "species",
        "genus",
        "taxon",
        "taxonomic group"
      ]
    },
    {
      "name": "Chemical",
      "of": "Object",
      "description": "A chemical element or simple substance (e.g. ``carbon``, ``hydrogen``, ``sodium chloride``)",
      "icon": "Science",
      "color": "#cc41d6",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "chemical",
        "element",
        "substance",
        "reagent"
      ]
    },
    {
      "name": "Compound",
      "of": "Object",
      "description": "A chemical compound or molecule — a defined combination of elements (e.g. ``H2SO4``, ``glucose``, ``ATP``)",
      "icon": "Hub",
      "color": "#d641c5",
      "quality_score": 18,
      "requires_named_referent": true,
      "rescue_keywords": [
        "compound",
        "molecule",
        "salt",
        "polymer"
      ]
    },
    {
      "name": "Equipment",
      "of": "Object",
      "description": "General scientific equipment or apparatus — a fixture or assembly used during research (centrifuge, fume hood, bench)",
      "icon": "Construction",
      "color": "#d641ac",
      "quality_score": 15,
      "requires_named_referent": true,
      "rescue_keywords": [
        "equipment",
        "apparatus",
        "device",
        "fixture"
      ]
    },
    {
      "name": "Instrument",
      "of": "Object",
      "description": "A scientific instrument used for measurement or observation (microscope, spectrometer, telescope, detector)",
      "icon": "Straighten",
      "color": "#d6418c",
      "quality_score": 15,
      "requires_named_referent": true,
      "rescue_keywords": [
        "instrument",
        "microscope",
        "spectrometer",
        "telescope",
        "detector"
      ]
    },
    {
      "name": "Equation",
      "of": "Concept",
      "description": "A mathematical equation — an equality between expressions (e.g. ``F=ma``, ``E=mc²``, ``Maxwell's equations``)",
      "icon": "Functions",
      "color": "#d64177",
      "quality_score": 15,
      "requires_named_referent": true,
      "rescue_keywords": [
        "equation",
        "law",
        "relation"
      ]
    },
    {
      "name": "Formula",
      "of": "Concept",
      "description": "A formula or expression — a named computational rule or chemical/structural representation",
      "icon": "Calculate",
      "color": "#d6415f",
      "quality_score": 15,
      "requires_named_referent": true,
      "rescue_keywords": [
        "formula",
        "expression",
        "rule",
        "chemical formula"
      ]
    },
    {
      "name": "Metric",
      "of": "Concept",
      "description": "A defined quantitative metric — the named thing being measured (e.g. ``signal-to-noise ratio``, ``Q-value``)",
      "icon": "Speed",
      "color": "#d64143",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "metric",
        "indicator",
        "unit",
        "quantity"
      ]
    },
    {
      "name": "Measurement",
      "of": "Concept",
      "description": "A specific recorded measurement — the value or observation (e.g. ``3.2 cm``, ``42 ± 0.5 keV``)",
      "icon": "Straighten",
      "color": "#d65f43",
      "quality_score": 15,
      "requires_named_referent": false,
      "rescue_keywords": [
        "measurement",
        "value",
        "observation",
        "reading"
      ]
    }
  ],
