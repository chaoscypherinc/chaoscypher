      "names_a_person": true,
      "icon": "Person",
      "color": "#d6b841",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "historical figure",
        "king",
        "emperor",
        "ruler",
        "leader",
        "statesman",
        "general",
        "reformer"
      ]
    },
