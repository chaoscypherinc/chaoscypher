{
  "@context": {
    "@vocab": "https://chaoscypher.io/schema/domain#",
    "schema": "https://schema.org/",
    "name": "schema:name",
    "description": "schema:description",
    "author": "schema:author",
    "version": "schema:version"
  },
  "@type": "ExtractionDomain",
  "@id": "domain:historical",
  "name": "historical",
  "version": "2.0.0",
  "description": "Historical documents, narratives, primary sources, and historiography",
  "role": "pack",
  "extends": "core",
  "author": "ChaosCypher Team",
  "builtin": true,
  "extraction_density": 1.1,
  "detection": {
    "@type": "DetectionConfig",
    "keywords": {
      "temporal": {
        "terms": [
          "century",
          "era",
          "period",
          "epoch",
          "decade",
          "millennium",
          "antiquity"
        ],
        "weight": 1.0
      },
      "events": {
        "terms": [
          "war",
          "treaty",
          "revolution",
          "battle",
          "reign",
          "conquest",
          "rebellion",
          "uprising",
          "independence",
          "colonization"
        ],
        "weight": 1.1
      },
      "structures": {
        "terms": [
          "dynasty",
          "empire",
          "kingdom",
          "republic",
          "monarchy",
          "civilization",
          "colony",
          "federation"
        ],
        "weight": 0.9
      },
      "historical_terms": {
        "terms": [
          "historical",
          "history",
          "medieval",
          "pre-historic",
          "classical",
          "renaissance",
          "enlightenment",
          "historiography",
          "historian"
        ],
        "weight": 1.0
      },
      "sources": {
        "terms": [
          "primary source",
          "chronicle",
          "manuscript",
          "archive",
          "artifact",
          "archaeological",
          "inscription",
          "document",
          "record"
        ],
        "weight": 0.9
      },
      "actors": {
        "terms": [
          "king",
          "queen",
          "emperor",
          "pharaoh",
          "sultan",
          "tsar",
          "general",
          "statesman",
          "reformer",
          "leader"
        ],
        "weight": 0.8
      }
    },
    "file_extensions": [],
    "doc_types": [
      "historical_document",
      "primary_source",
      "historiography"
    ],
    "patterns": [
      {
        "regex": "(?i)\\b\\d{1,2}(st|nd|rd|th)\\s+century\\b",
        "weight": 1.4,
        "description": "Century references"
      },
      {
        "regex": "(?i)\\b\\d{3,4}\\s*(ad|bc|bce|ce|a\\.d\\.|b\\.c\\.)\\b",
        "weight": 1.3,
        "description": "Year with era"
      },
      {
        "regex": "(?i)\\b(circa|c\\.|ca\\.|approx\\.?)\\s*\\d{3,4}\\b",
        "weight": 1.2,
        "description": "Approximate dates"
      },
      {
        "regex": "(?i)\\b(reign|dynasty|era)\\s+of\\b",
        "weight": 1.1,
        "description": "Reign/period patterns"
      },
      {
        "regex": "(?i)\\b(ancient|medieval|renaissance|modern|pre-war|post-war|colonial)\\b",
        "weight": 0.9,
        "description": "Historical era terms"
      }
    ],
    "confidence": {
      "base_score": 0.25,
      "per_keyword_boost": 0.04,
      "extension_boost": 0.0,
      "doc_type_boost": 0.25,
      "pattern_boost": 0.15,
      "max_confidence": 0.95,
      "min_threshold": 0.4
    }
  },
  "entity_exclusions": [
    {
      "description": "Vague date references",
      "examples": [
        "at that time",
        "in those days",
        "later"
      ]
    }
  ],
  "entity_guidance": "ENTITY EXTRACTION RULES:\n- Extract historical events, figures, eras, locations, and primary sources\n- Use canonical names with all variants as aliases\n- Include dates and time periods in properties\n\nDO NOT EXTRACT:\n- Vague date references: 'at that time', 'in those days', 'later'\n- Modern editorial content: footnote numbers, [sic], translator notes\n- Page or chapter references from the source document",
  "relationship_guidance": "RELATIONSHIP EXTRACTION RULES:\n- CHRONOLOGY: Link events to eras with occurred_during. Use preceded for sequences\n- CAUSATION: Capture cause-effect chains with caused relationship\n- FIGURES: Use participated_in, led, signed for historical figures' roles\n- SOURCES: Link events to primary sources with documented_in\n",
  "subtypes": [
    {
      "name": "Historical Event",
      "of": "Event",
      "description": "A historical occurrence or event",
      "icon": "Event",
      "color": "#d68341",
      "quality_score": 25,
      "requires_named_referent": true,
      "rescue_keywords": [
        "event",
        "occurred in",
        "took place",
        "battle of",
        "treaty of",
        "war of",
        "revolution",
        "siege of"
      ]
    },
    {
      "name": "Historical Figure",
      "of": "Person",
      "description": "A person of historical significance",
      "properties": [
        {
          "name": "birth_year",
          "display_name": "Birth Year",
          "property_type": "text"
        },
        {
          "name": "death_year",
          "display_name": "Death Year",
          "property_type": "text"
        },
        {
          "name": "title",
