        "note": "Ranks and titles become aliases"
      },
      {
        "canonical": "Lady Maren Ashby",
        "aliases": [
          "The Young Widow",
          "Maren Ashby"
        ],
        "note": "Nicknames and epithets become aliases"
      },
      {
        "canonical": "Ilias Venn",
        "aliases": [
          "Harbourmaster Venn",
          "Ili",
          "Old Venn"
        ],
        "note": "Signature names and diminutives are aliases - Ili is the informal form of Ilias"
      }
    ],
    "relationship_examples": [
      {
        "source": "Tobin Ashby",
