        "source": "Corvin Lusk",
        "target": "Lady Maren Ashby",
        "type": "courts",
        "note": "Use courts for romantic pursuit (Corvin Lusk courts Lady Maren)"
      },
      {
        "source": "Ilias Venn",
        "target": "Edrin Moss",
        "type": "admires",
        "note": "Use admires for respect or fascination"
      }
    ]
