        "id": "lit_edge_ally_of",
        "name": "ally_of",
        "description": "Friend, supporter, or ally — between Characters, or with faction-like Locations and Social Groups (e.g. 'Margrave Kell sided with the river guilds')",
        "icon": "Handshake",
        "color": "#9732cc",
        "symmetric": true,
        "quality_score": 25,
        "source_types": [
          "Person",
          "Location",
          "Group"
        ],
        "target_types": [
          "Person",
          "Location",
          "Group"
        ],
        "two_endpoints_only": true,
        "two_endpoints_only_reason": "Replayed on the v3 corpus (audit wave 6) 'ally' and 'allies' add no edge either way, so nothing shows them to be evidence yet; in this genre's war prose they name nations and armies as often as one person's ally."
      },
