  "examples": {
    "alias_examples": [
      {
        "canonical": "APT29",
        "aliases": [
          "Cozy Bear",
          "The Dukes",
          "NOBELIUM",
          "Midnight Blizzard",
          "YTTRIUM"
        ],
        "note": "APT groups have many vendor-specific names that become aliases"
      },
      {
        "canonical": "EternalBlue",
        "aliases": [
          "MS17-010",
          "CVE-2017-0144"
        ],
        "note": "Exploit names and CVE IDs become aliases"
      }
    ],
    "relationship_examples": [
      {
        "source": "APT28",
        "target": "Sofacy",
        "type": "uses_tool",
        "note": "Use uses_tool for actor-malware relationships"
      },
      {
        "source": "Log4Shell",
        "target": "Apache Log4j",
        "type": "affects",
        "note": "Use affects for vulnerability-software relationships"
      }
    ]
  },
  "extraction_limits": {
    "max_relationship_ratio": 6.0,
    "loop_max_entity_count": 35
  },
  "quality_scoring": {
    "default_entity_score": 18,
    "default_relationship_score": 15
  },
  "title_words": [
    "mr",
    "mrs",
    "ms",
    "miss",
    "dr",
    "sir",
    "dame",
    "madam",
    "the",
    "of",
    "de",
    "von",
    "van"
  ],
  "content_exclusions": {
    "categories": [
      "toc",
      "changelog",
      "legal",
      "boilerplate",
      "metadata",
      "web_artifacts",
      "advertising"
    ]
  },
  "extraction_filtering_mode": "strict",
  "icon": "Security"
}
