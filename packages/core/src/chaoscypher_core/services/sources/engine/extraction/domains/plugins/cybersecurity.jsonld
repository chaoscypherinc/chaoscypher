        "weight": 1.0
      },
      "cloud_security": {
        "terms": [
          "cloud security",
          "IAM",
          "S3 bucket",
          "Azure AD",
          "container escape",
          "Kubernetes",
          "serverless",
          "cloud misconfiguration",
          "CSPM",
